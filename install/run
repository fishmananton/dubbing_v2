sudo nano /etc/systemd/system/prefect-server.service
[Unit]
Description=Prefect Server
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=dubbed
Group=dubbed
WorkingDirectory=/home/dubbed/app/
EnvironmentFile=/etc/prefect-server.env
ExecStart=/home/dubbed/app/.venv/bin/prefect server start --host 127.0.0.1 --port 4200
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target


