nano /etc/systemd/system/dubbed-prefect-serve.service

[Unit]
Description=Dubbed Prefect Serve Runner
After=network.target prefect-server.service dubbed-backend.service
Requires=prefect-server.service

[Service]
Type=simple
User=dubbed
Group=dubbed
WorkingDirectory=/home/dubbed/app
EnvironmentFile=/etc/prefect-server.env
ExecStart=/home/dubbed/app/.venv/bin/python /home/dubbed/app/api/serve.py
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target


sudo systemctl daemon-reload
sudo systemctl enable dubbed-prefect-serve
sudo systemctl start dubbed-prefect-serve
sudo systemctl status dubbed-prefect-serve


